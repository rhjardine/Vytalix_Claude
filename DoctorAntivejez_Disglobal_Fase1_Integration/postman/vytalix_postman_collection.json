    {
      "name": "Payments (Disglobal webhook)",
      "item": [
        {
          "name": "Flujo de Pago Integrado B2B — webhook confirmado (HMAC)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build the canonical body and sign it with HMAC-SHA256.",
                  "// Key order must match the server's canonicalBody() exactly:",
                  "// event, intentId, amount, currency, timestamp, subjectRef, metadata",
                  "const payload = {",
                  "  event:      'payment.confirmed',",
                  "  intentId:   'intent-' + Date.now(),",
                  "  amount:     4900,",
                  "  currency:   'USD',",
                  "  timestamp:  new Date().toISOString(),",
                  "  subjectRef: pm.collectionVariables.get('subjectRef') || 'DISG-8c1e5a',",
                  "  metadata:   { product: 'FACIAL_SCAN' }",
                  "};",
                  "const canonical = JSON.stringify(payload);",
                  "const secret = pm.collectionVariables.get('webhook_secret');",
                  "const signature = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('webhook_body', JSON.stringify(Object.assign({}, payload, { signature })));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Authenticated by the HMAC-SHA256 `signature` field, not by an API key. 200 = payment committed (replayed:true if the intentId already existed); 401 = signature mismatch; 500 = NOT recorded, retry the same intentId (deduplication makes it safe).",
            "body": {
              "mode": "raw",
              "raw": "{{webhook_body}}"
            },
            "url": {
              "raw": "{{base_url}}/api/v2/webhooks/payment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v2",
                "webhooks",
                "payment"
              ]
            }
          }
        }
      ]
    }
  ]
