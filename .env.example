# =============================================================================
# Vytalix Platform — environment template
# Copy to .env and adjust. Every variable below is read somewhere in src/;
# the defaults shown are the ones the code falls back to.
#   cp .env.example .env
# Only DATABASE_URL is strictly required to boot with persistence.
# NEVER commit a real .env — it is git-ignored.
# =============================================================================

# ── Core runtime ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001                       # HTTP port for the platform server (default: 3001)
API_PORT=3001                   # secondary API port used by the legacy v2 entry
LOG_LEVEL=info                  # pino level: trace|debug|info|warn|error
ALLOWED_ORIGINS=http://localhost:3000   # CORS allow-list, comma-separated

# ── Persistence (required) ───────────────────────────────────────────
# PostgreSQL 16. Row Level Security is enforced, so the app must NOT
# connect as the table owner/superuser in production.
DATABASE_URL=postgresql://vytalix:vytalix@localhost:5432/vytalix
DB_POOL_MAX=10                  # max pg pool connections

# ── Cache / rate limiting ────────────────────────────────────────────
# Used for idempotency, service activation flags, rate limiting and
# brute-force counters. If unreachable, those degrade to in-process state.
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production      # HS256 signing secret (no default in code)
JWT_EXPIRES_IN=8h
TENANT_SECRET_FALLBACK=                 # fallback secret for subject pseudonymisation

# ── Disglobal integration ────────────────────────────────────────────
# HMAC-SHA256 secret for POST /api/v2/webhooks/payment. The signature is
# computed over the canonical JSON body (see scripts/examples/).
DISGLOBAL_WEBHOOK_SECRET=sandbox-webhook-secret-v1
DEFAULT_FUNNEL_TENANT_ID=a1b2c3d4-0000-4000-8000-000000000001
VYTALIX_API_KEY=                # API key used by the SDK client
VYX_API_KEY=                    # alias consumed by the Disglobal SDK

# ── Facial analysis (AWS Rekognition) ────────────────────────────────
# 'mock' needs no credentials and is the default; 'aws' calls DetectFaces.
VISION_PROVIDER=mock            # mock | aws
FACIAL_FALLBACK_MOCK=false      # fall back to mock if the provider fails
AWS_REGION=us-east-1
REKOGNITION_TIMEOUT_MS=5000
# AWS credentials are resolved by the SDK default chain (env, profile, role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Notifications ────────────────────────────────────────────────────
# 'log' writes to the logger and needs no third-party credentials.
NOTIFICATION_PROVIDER=log       # log | sendgrid | twilio
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vytalix.health
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_NUMBER=58412XXXXXXX    # booking hand-off number shown to patients

# ── Optional / demo ──────────────────────────────────────────────────
EVENTBRIDGE_BUS_NAME=vytalix-clinical   # only used by the EventBridge adapter
DEMO_WEBHOOK_URL=https://webhook.site/vytalix-demo
WEBHOOK_SECRET=demo_webhook_secret      # demo outbound webhook signing
